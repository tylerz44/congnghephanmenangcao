@model FashionStore.Models.Order

@{
    ViewData["Title"] = "Chi tiết đơn hàng";
}

<h2 class="mb-4">Chi tiết đơn hàng #@Model.OrderId</h2>

<div class="card mb-4">
    <div class="card-body">
        <p><strong>Người nhận:</strong> @Model.ReceiverName</p>
        <p><strong>Số điện thoại:</strong> @Model.ReceiverPhone</p>
        <p><strong>Địa chỉ:</strong> @Model.ShippingAddress</p>
        <p><strong>Phương thức thanh toán:</strong> @Model.PaymentMethod</p>
        <p><strong>Trạng thái:</strong> @Model.ShippingStatus</p>
        <p><strong>Ngày đặt:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
    </div>
</div>

<table class="table table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Ảnh</th>
            <th>Sản phẩm</th>
            <th>SL</th>
            <th>Đơn giá</th>
            <th>Thành tiền</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model.OrderDetails)
        {
            <tr>

                <td width="120">
                    <img src="@item.Product?.ImageUrl"
                         width="100"
                         class="rounded" />
                </td>

                <td>@item.Product?.ProductName</td>

                <td>@item.Quantity</td>

                <td>@item.Price.ToString("N0") đ</td>

                <td>@((item.Price * item.Quantity).ToString("N0")) đ</td>

            </tr>
        }

    </tbody>

</table>

<div class="text-end">

    <h3 class="text-danger">
        Tổng tiền: @Model.Total.ToString("N0") đ
    </h3>

    <a asp-action="History"
       class="btn btn-secondary">
        ← Quay lại
    </a>

</div>