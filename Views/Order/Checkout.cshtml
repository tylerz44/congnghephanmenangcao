@model FashionStore.Models.Cart

@{
    ViewData["Title"] = "Thanh toán";
}

<h2 class="mb-4">Thanh toán</h2>

<form asp-action="Checkout"
      method="post">

    <div class="row">

        <div class="col-md-7">

            <div class="mb-3">

                <label>Họ tên</label>

                <input name="receiverName"
                       class="form-control" />

            </div>

            <div class="mb-3">

                <label>Số điện thoại</label>

                <input name="phone"
                       class="form-control" />

            </div>

            <div class="mb-3">

                <label>Địa chỉ</label>

<textarea name="address"
          class="form-control"></textarea>

            </div>

            <div class="mb-3">

                <label>Ghi chú</label>

<textarea name="note"
          class="form-control"></textarea>

            </div>

            <div class="mb-3">

                <label>Phương thức thanh toán</label>

                <select name="payment"
                        class="form-select">

                    <option>Thanh toán khi nhận hàng (COD)</option>

                    <option>Chuyển khoản</option>

                    <option>Ví điện tử</option>

                </select>

            </div>

        </div>

        <div class="col-md-5">

            <div class="card">

                <div class="card-header">

                    Đơn hàng

                </div>

                <div class="card-body">

                    @foreach (var item in Model.Items)
                    {
                        <p>

                            @item.ProductName

                            x

                            @item.Quantity

                        </p>
                    }

                    <hr />

                    <h3 class="text-danger">

                        @Model.TotalPrice.ToString("N0") đ

                    </h3>

                    <button class="btn btn-success w-100">

                        Đặt hàng

                    </button>

                </div>

            </div>

        </div>

    </div>


</form>

