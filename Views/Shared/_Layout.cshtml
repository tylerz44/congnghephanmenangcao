@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - FashionStore</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">

        <div class="container">

            <a class="navbar-brand fw-bold fs-3"
               asp-controller="Home"
               asp-action="Index">

                𝕭𝕼 𝕱𝕬𝕾𝕳𝕴𝕺𝕹

            </a>

            <button class="navbar-toggler"
                    data-bs-toggle="collapse"
                    data-bs-target="#menu">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse"
                 id="menu">

                <ul class="navbar-nav mx-auto">
                    @if (Context.Session.GetString("Role") == "Admin")
                    {
                        <li class="nav-item">
                            <a asp-controller="Admin"
                               asp-action="Dashboard"
                               class="nav-link text-danger fw-bold">

                                Dashboard

                            </a>
                        </li>
                    }
                    <li class="nav-item">

                        <a class="nav-link px-3"
                           asp-controller="Home"
                           asp-action="Index">

                            Trang chủ

                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link px-3"
                           asp-controller="Product"
                           asp-action="Index">

                            Sản phẩm

                        </a>

                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Product"
                           asp-action="Index"
                           asp-route-gender="Nam">
                            Nam
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Product"
                           asp-action="Index"
                           asp-route-gender="Nữ">
                            Nữ
                        </a>
                    </li>

                    <li class="nav-item">

                        <a class="nav-link text-danger fw-bold"
                           asp-controller="Product"
                           asp-action="Index"
                           asp-route-sale="true">

                            🔥 SALE

                        </a>

                    </li>

                </ul>

                <div class="d-flex align-items-center">

                    <form asp-controller="Product"
                          asp-action="Index"
                          method="get"
                          class="d-flex me-3">

                        <input type="text"
                               name="keyword"
                               class="form-control"
                               placeholder="Tìm sản phẩm..."
                               value="@Context.Request.Query["keyword"]">

                        <button class="btn btn-dark ms-2">
                            🔍
                        </button>

                    </form>


                    <a asp-controller="Cart"
                       asp-action="Index"
                       class="btn btn-dark me-2">

                        🛒

                    </a>

                    @if (Context.Session.GetInt32("UserId") != null)
                    {
                        <div class="dropdown">

                            <button class="btn btn-outline-dark dropdown-toggle"
                                    data-bs-toggle="dropdown">

                                👤
                                @Context.Session.GetString("FullName")

                            </button>

                            <ul class="dropdown-menu">

                                <li>

                                    <a class="dropdown-item"
                                       asp-controller="Account"
                                       asp-action="Profile">

                                        Hồ sơ

                                    </a>

                                </li>

                                <li>

                                    <a class="dropdown-item"
                                       asp-controller="Order"
                                       asp-action="History">

                                        Đơn hàng

                                    </a>

                                </li>

                                <li>

                                    <hr>

                                </li>

                                <li>

                                    <a class="dropdown-item text-danger"
                                       asp-controller="Account"
                                       asp-action="Logout">

                                        Đăng xuất

                                    </a>

                                </li>

                            </ul>

                        </div>
                    }
                    else
                    {
                        <a asp-controller="Account"
                           asp-action="Login"
                           class="btn btn-dark">

                            Đăng nhập

                        </a>
                    }

                </div>

            </div>

        </div>

    </nav>
 

    @if (ViewContext.RouteData.Values["Controller"]?.ToString() == "Home")
    {
        @RenderBody()
    }
    else
    {
        <div class="container mt-4">
            @RenderBody()
        </div>
    }

    <footer class="bg-dark text-white mt-5">

        <div class="container py-5">

            <div class="row">

                <div class="col-md-4">

                    <h3>FASHION</h3>

                    <p>
                        Thời trang hiện đại dành cho mọi phong cách.
                    </p>

                </div>

                <div class="col-md-4">

                    <h5>Liên hệ</h5>

                    <p>Email: support@fashion.com</p>

                    <p>Hotline: 1900 1234</p>

                </div>

                <div class="col-md-4">

                    <h5>Theo dõi</h5>

                    <p>Facebook</p>

                    <p>Instagram</p>

                    <p>TikTok</p>

                </div>

            </div>

        </div>

    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>