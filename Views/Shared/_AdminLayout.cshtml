<!DOCTYPE html>
<html lang="vi">
<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" />

</head>

<body>

    <div class="d-flex">

        <div class="bg-dark text-white p-3"
             style="width:260px;height:100vh;position:fixed;">

            <h3 class="mb-4">

                👑 ADMIN

            </h3>
            <div class="mb-3">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="text-white text-decoration-none">

                    🏠 Về trang chủ

                </a>

            </div>

            <a asp-controller="Admin"
               asp-action="Dashboard"
               class="d-block text-white text-decoration-none mb-3">

                📊 Tổng quan

            </a>

            <a asp-controller="Admin"
               asp-action="Products"
               class="d-block text-white text-decoration-none mb-3">

                👕 Quản lý sản phẩm

            </a>

            <a asp-controller="Admin"
               asp-action="Categories"
               class="d-block text-white text-decoration-none mb-3">

                📂 Quản lý danh mục

            </a>

            <a asp-controller="Admin"
               asp-action="Orders"
               class="d-block text-white text-decoration-none mb-3">

                📦 Quản lý đơn hàng

            </a>

            <a asp-controller="Admin"
               asp-action="Customers"
               class="d-block text-white text-decoration-none mb-3">

                👥 Quản lý khách hàng

            </a>

            <a asp-controller="Admin"
               asp-action="Revenue"
               class="d-block text-white text-decoration-none mb-3">

                💰 Doanh thu

            </a>

            <a asp-controller="Admin"
               asp-action="Settings"
               class="d-block text-white text-decoration-none">

                ⚙️ Cài đặt

            </a>

            <a asp-controller="Account"
               asp-action="Logout"
               class="d-block text-danger text-decoration-none">

                🚪 Đăng xuất

            </a>

        </div>

        <div style="margin-left:270px;width:100%;padding:30px;">

            @RenderBody()

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
<hr class="text-secondary" />

