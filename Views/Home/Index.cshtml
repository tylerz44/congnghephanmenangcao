@model IEnumerable<FashionStore.Models.Product>

@{
    ViewData["Title"] = "Trang chủ";
}

<!-- ================= Banner ================= -->

<div id="fashionCarousel" class="carousel slide" data-bs-ride="carousel">

    <div class="carousel-inner">

        <div class="carousel-item active">

            <img src="~/images/banner1.jpg"
                 class="d-block w-100 banner-img">

            <div class="carousel-caption">

                <h1>NEW COLLECTION 2026</h1>

                <p>Khẳng định phong cách của bạn</p>

                <a asp-controller="Product"
                   asp-action="Index"
                   class="btn btn-dark btn-lg">

                    MUA NGAY

                </a>

            </div>

        </div>

        <div class="carousel-item">

            <img src="~/images/banner2.jpg"
                 class="d-block w-100 banner-img">

            <div class="carousel-caption">

                <h1>SUMMER SALE</h1>

                <p>Giảm giá đến 50%</p>

            </div>

        </div>

        <div class="carousel-item">

            <img src="~/images/banner3.jpg"
                 class="d-block w-100 banner-img">

            <div class="carousel-caption">

                <h1>FASHION STORE</h1>

                <p>Phong cách của riêng bạn</p>

            </div>

        </div>

    </div>

    <button class="carousel-control-prev"
            type="button"
            data-bs-target="#fashionCarousel"
            data-bs-slide="prev">

        <span class="carousel-control-prev-icon"></span>

    </button>

    <button class="carousel-control-next"
            type="button"
            data-bs-target="#fashionCarousel"
            data-bs-slide="next">

        <span class="carousel-control-next-icon"></span>

    </button>

</div>

<!-- ================= Danh mục ================= -->

<section class="container my-5">

    <h2 class="text-center fw-bold mb-5">

        DANH MỤC

    </h2>

    <div class="row">

        @foreach (var c in Model
        .Where(x => x.Category != null)
        .Select(x => x.Category!)
        .DistinctBy(x => x.CategoryId))
        {
            var image = c.CategoryName switch
            {
                "Áo" => "ao.jpg",
                "Quần" => "quan.jpg",
                "Phụ Kiện" => "phukien.jpg",
                "Giày" => "giay.jpg",
                _ => "default.jpg"
            };

            <div class="col-lg-3 col-md-6 mb-4">

                <a asp-controller="Product"
                   asp-action="Index"
                   asp-route-categoryId="@c.CategoryId"
                   class="text-decoration-none">

                    <div class="card shadow border-0 h-100 category-card">

                        <img src="~/images/category/@image"
                             class="card-img-top"
                             style="height:250px;object-fit:cover;">

                        <div class="card-body text-center">

                            <h4 class="fw-bold text-dark">

                                @c.CategoryName

                            </h4>

                        </div>

                    </div>

                </a>

            </div>
        }

    </div>

</section>

<!-- ================= Sản phẩm nổi bật ================= -->

<section class="container my-5">

    <h2 class="text-center fw-bold mb-5">

        🔥 SẢN PHẨM NỔI BẬT

    </h2>

    <div class="row">

        @foreach (var item in Model.Take(8))
        {
            <div class="col-lg-3 col-md-6 mb-4">

                <div class="card product-card h-100 shadow border-0">

                    <img src="@item.ImageUrl"
                         class="card-img-top"
                         style="height:300px;object-fit:cover;">

                    <div class="card-body">

                        <h5>@item.ProductName</h5>

                        <small class="text-muted">

                            @item.Brand

                        </small>

                        <h4 class="text-danger mt-2">

                            @item.Price.ToString("N0") đ

                        </h4>

                        <div class="d-grid mt-3">

                            <a asp-controller="Product"
                               asp-action="Detail"
                               asp-route-id="@item.ProductId"
                               class="btn btn-dark">

                                Xem ngay

                            </a>

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>

</section>

<!-- ================= Dịch vụ ================= -->

<section class="bg-light py-5 mt-5">

    <div class="container">

        <div class="row text-center">

            <div class="col-md-3">

                <h1>🚚</h1>

                <h4>Miễn phí ship</h4>

                <p>Toàn quốc</p>

            </div>

            <div class="col-md-3">

                <h1>💳</h1>

                <h4>Thanh toán</h4>

                <p>An toàn</p>

            </div>

            <div class="col-md-3">

                <h1>↩</h1>

                <h4>Đổi trả</h4>

                <p>7 ngày</p>

            </div>

            <div class="col-md-3">

                <h1>☎</h1>

                <h4>Hỗ trợ</h4>

                <p>24/7</p>

            </div>

        </div>

    </div>

</section>