@model FashionStore.Models.Category

@{
    ViewData["Title"] = "Thêm danh mục";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-success text-white">

            <h3>Thêm danh mục</h3>

        </div>

        <div class="card-body">

            <form asp-action="Create" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger">
                </div>

                <div class="mb-3">

                    <label asp-for="CategoryName"
                           class="form-label">
                    </label>

                    <input asp-for="CategoryName"
                           class="form-control" />

                    <span asp-validation-for="CategoryName"
                          class="text-danger">
                    </span>

                </div>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Quay lại

                </a>

                <button type="submit"
                        class="btn btn-success">

                    Thêm

                </button>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}