@model IEnumerable<FashionStore.Models.Product>

@{
    ViewData["Title"] = "Sản phẩm";
}

<div class="container-fluid mt-4">

    <div class="row">

        <!-- Bộ lọc -->
        <div class="col-lg-3">

            <form method="get">

                <div class="card shadow-sm">

                    <div class="card-body">

                        <h4 class="mb-3">Bộ lọc</h4>

                        <div class="mb-3">

                            <label>Danh mục</label>

                            <select name="categoryId" class="form-select">

                                <option value="">Tất cả</option>

                                @foreach (var c in ViewBag.Categories)
                                {
                                    <option value="@c.CategoryId"
                                            selected="@(Context.Request.Query["categoryId"]==c.CategoryId.ToString())">
                                        @c.CategoryName
                                    </option>
                                }

                            </select>

                        </div>

                        <div class="mb-3">

                            <label>Size</label>

                            <select name="size" class="form-select">

                                <option value="">Tất cả</option>

                                <option value="S" selected="@(Context.Request.Query["size"]=="S")">S</option>

                                <option value="M" selected="@(Context.Request.Query["size"]=="M")">M</option>

                                <option value="L" selected="@(Context.Request.Query["size"]=="L")">L</option>

                                <option value="XL" selected="@(Context.Request.Query["size"]=="XL")">XL</option>

                            </select>

                        </div>

                        <div class="mb-3">

                            <label>Màu</label>

                            <select name="color" class="form-select">

                                <option value="">Tất cả</option>

                                <option value="Đen" selected="@(Context.Request.Query["color"]=="Đen")">Đen</option>

                                <option value="Trắng" selected="@(Context.Request.Query["color"]=="Trắng")">Trắng</option>

                                <option value="Xanh" selected="@(Context.Request.Query["color"]=="Xanh")">Xanh</option>

                            </select>

                        </div>

                        <div class="mb-3">

                            <label>Giới tính</label>

                            <select name="gender" class="form-select">

                                <option value="">Tất cả</option>

                                <option value="Nam"
                                        selected="@(Context.Request.Query["gender"]=="Nam")">
                                    Nam
                                </option>

                                <option value="Nữ"
                                        selected="@(Context.Request.Query["gender"]=="Nữ")">
                                    Nữ
                                </option>

                            </select>

                        </div>
                        <div class="form-check mb-3">

                            <input class="form-check-input"
                                   type="checkbox"
                                   name="sale"
                                   value="true"
                                   id="sale"
                            @(Context.Request.Query["sale"] == "true" ? "checked" : "")>

                            <label class="form-check-label" for="sale">

                                Chỉ sản phẩm SALE 🔥

                            </label>

                        </div>

                        <button class="btn btn-dark w-100">

                            Lọc sản phẩm

                        </button>

                    </div>

                </div>

            </form>

        </div>

        <!-- Danh sách -->

        <div class="col-lg-9">

            <div class="d-flex justify-content-between align-items-center mb-4">

                <h2>Sản phẩm</h2>

                @if (Context.Session.GetString("Role") == "Admin")
                {
                    <a asp-action="Create"
                       class="btn btn-success">
                        ➕ Thêm sản phẩm
                    </a>
                }

            </div>

            <div class="row">

                @foreach (var item in Model)
                {

                    <div class="col-lg-4 col-md-6 mb-4">

                        <div class="card shadow-sm h-100">

                            <img src="@item.ImageUrl"
                                 class="card-img-top"
                                 style="height:280px;object-fit:cover;">

                            <div class="card-body d-flex flex-column">

                                <h5>@item.ProductName</h5>

                                <small class="text-muted">@item.Brand</small>

                                <p class="mt-2">

                                    <strong>Danh mục:</strong>

                                    @item.Category?.CategoryName

                                </p>

                                <p>

                                    <strong>Giới tính:</strong>

                                    @item.Gender

                                </p>
                                @if (item.SalePrice.HasValue)
                                {
                                    var percent = (int)Math.Round(
                                    (item.Price - item.SalePrice.Value)
                                    / item.Price * 100);

                                    <span class="badge bg-danger mb-2">
                                        -@percent%
                                    </span>

                                    <div>
                                        <del class="text-muted">
                                            @item.Price.ToString("N0") đ
                                        </del>
                                    </div>

                                    <h4 class="text-danger fw-bold">
                                        @item.SalePrice.Value.ToString("N0") đ
                                    </h4>
                                }
                                else
                                {
                                    <h4 class="text-danger">
                                        @item.Price.ToString("N0") đ
                                    </h4>
                                }

                                <p class="text-muted">

                                    Còn @item.Quantity sản phẩm

                                </p>


                                <div class="mt-auto">

                                    <form asp-controller="Cart"
                                          asp-action="AddToCart"
                                          method="post">

                                        <input type="hidden"
                                               name="id"
                                               value="@item.ProductId" />

                                        <input type="hidden"
                                               name="quantity"
                                               value="1" />

                                        <input type="hidden"
                                               name="size"
                                               value="@((item.Size ?? "").Split(',').FirstOrDefault())" />

                                        <input type="hidden"
                                               name="color"
                                               value="@((item.Color ?? "").Split(',').FirstOrDefault())" />

                                        @if (Context.Session.GetInt32("UserId") != null)
                                        {
                                            <button class="btn btn-warning w-100 mb-2">
                                                🛒 Thêm vào giỏ
                                            </button>
                                        }
                                        else
                                        {
                                            <a asp-controller="Account"
                                               asp-action="Login"
                                               class="btn btn-secondary w-100 mb-2">
                                                Đăng nhập để mua
                                            </a>
                                        }

                                    </form>

                                    <a asp-action="Detail"
                                       asp-route-id="@item.ProductId"
                                       class="btn btn-dark w-100 mb-2">

                                        Xem chi tiết

                                    </a>

                                    @if (Context.Session.GetString("Role") == "Admin")
                                    {

                                        <a asp-action="Edit"
                                           asp-route-id="@item.ProductId"
                                           class="btn btn-primary w-100 mb-2">

                                            ✏️ Sửa

                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.ProductId"
                                           class="btn btn-danger w-100">

                                            🗑 Xóa

                                        </a>

                                    }

                                </div>

                            </div>

                        </div>

                    </div>

                }

            </div>

            <!-- Phân trang -->

            <nav>

                <ul class="pagination justify-content-center">

                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {

                        <li class="page-item @(i==ViewBag.CurrentPage?"active":"")">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@i"
                               asp-route-keyword="@Context.Request.Query["keyword"]"
                               asp-route-categoryId="@Context.Request.Query["categoryId"]"
                               asp-route-size="@Context.Request.Query["size"]"
                               asp-route-color="@Context.Request.Query["color"]"
                               asp-route-gender="@Context.Request.Query["gender"]"
                               asp-route-sale="@ViewContext.HttpContext.Request.Query["sale"]">
                            

                                @i

                            </a>

                        </li>

                    }

                </ul>

            </nav>

        </div>

    </div>

</div>