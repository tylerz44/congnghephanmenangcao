@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid mt-4">

    <h2 class="mb-4">

        📊 Dashboard Admin

    </h2>

    <div class="row">

        <div class="col-md-3">

            <div class="card shadow border-0 bg-primary text-white">

                <div class="card-body">

                    <h5>Sản phẩm</h5>

                    <h2>@ViewBag.TotalProducts</h2>

                </div>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card shadow border-0 bg-success text-white">

                <div class="card-body">

                    <h5>Khách hàng</h5>

                    <h2>@ViewBag.TotalCustomers</h2>

                </div>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card shadow border-0 bg-warning">

                <div class="card-body">

                    <h5>Đơn hàng</h5>

                    <h2>@ViewBag.TotalOrders</h2>

                </div>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card shadow border-0 bg-danger text-white">

                <div class="card-body">

                    <h5>Doanh thu</h5>

                    <h2>@String.Format("{0:N0}", ViewBag.TotalRevenue) đ</h2>

                </div>

            </div>

        </div>

    </div>

</div>